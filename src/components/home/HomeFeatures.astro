---
import { Image } from "astro:assets";
import ManageTags from "../../assets/screenshot_manage_tags.png";
const steps = [
  {
    title: "Connect Flickr",
    copy: "Create your Skedr account and authorize access to your Flickr account. Your photos stay on Flickr.",
  },
  {
    title: "Configure a group with tags",
    copy: "Choose a Flickr group you belong to. Give it a tag that describes the photos you want to share there, such as mountain.",
  },
  {
    title: "Sync a matching photo",
    copy: "Choose a photo with that tag and select Sync. Skedr submits sharing requests to your matching, configured groups.",
  },
];
---

<section
  id="how-it-works"
  class="home-section home-surface"
  aria-labelledby="steps-title"
>
  <div class="home-container">
    <div class="home-section-heading">
      <p class="home-eyebrow">Your first share</p>
      <h2 id="steps-title">One group. One tag. You’re on your way.</h2>
      <p>
        No need to configure every group at once. Start with somewhere your
        photo belongs.
      </p>
    </div>
    <ol class="home-steps">
      {
        steps.map((step, index) => (
          <li>
            <>
              <span class="home-step-number" aria-hidden="true">
                0{index + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </>
          </li>
        ))
      }
    </ol>
    <p class="home-rules">
      Sync submits your photo for sharing; it doesn’t guarantee acceptance by
      every group. Flickr group rules, permissions and limits still apply.
    </p>
    <details class="home-demo">
      <summary>Take a closer look at Skedr</summary>
      <div class="home-demo-content">
        <figure>
          <Image
            src={ManageTags}
            alt="Skedr’s Manage group tags panel showing tags assigned to a Flickr group and matching photos"
            loading="lazy"
            widths={[640, 960, 1592]}
            sizes="(max-width: 768px) 90vw, 960px"
          />
          <figcaption>Assign tags to a group in Skedr.</figcaption>
        </figure>
        <h3>Watch the sharing demo</h3>
        <video
          id="checkout-video"
          controls
          preload="none"
          poster="/video_poster.png"
          aria-label="Skedr sharing demonstration"
        >
          <source
            src="https://www.flickr.com/photos/skedr/53734335193/play/1080p/a071b153fb/"
            type="video/mp4"
          />
          Your browser does not support embedded video.
        </video>
      </div>
    </details>
  </div>
</section>
