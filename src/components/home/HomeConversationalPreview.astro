---
import { conversationalSignup, conversationalStarters } from "../../utils/conversationalLinks";
const steps = [
  ["Connect Flickr", "Your photos stay on Flickr. Use the familiar authorization form to connect your account."],
  ["Describe your goal", "Tell Skedr what you photograph and which groups you want to work with."],
  ["Review your setup", "Read the rules, check membership and review matching tags. Some groups require approval."],
  ["Share and follow progress", "Confirm sharing to all matching configured groups. See real outcomes and scheduled retries."],
];
---
<div class="conversation-home" data-conversational-home>
  <section class="conversation-hero" aria-labelledby="conversation-hero-title">
    <div class="conversation-copy">
      <p class="conversation-eyebrow">Your Flickr workflow, in your own words</p>
      <h1 id="conversation-hero-title">More photography.<br />Less sharing admin.</h1>
      <p class="conversation-lead">Turn a photography goal into a reviewed sharing setup. Work with your Flickr groups, photo tags and sharing progress—without repeating the same admin for every photo.</p>
      <div class="conversation-actions">
        <a class="conversation-primary try-it-for-free" href={conversationalSignup("hero")} data-conversation-cta data-placement="hero">Set up with Skedr</a>
        <a class="conversation-secondary" href="#conversational-preview">See how it works <span aria-hidden="true">↓</span></a>
      </div>
      <p class="conversation-note">Existing Groups, Photostream and queue pages stay available. You remain in control of consequential actions.</p>
    </div>
    <figure class="conversation-example" aria-describedby="conversation-disclosure">
      <figcaption>Illustrative conversation · Bird photo sharing</figcaption>
      <p class="conversation-person"><strong>Photographer · Example</strong><span>Help me set up sharing for my bird photos.</span></p>
      <div class="conversation-response"><strong>Skedr · Example</strong><p>Let’s inspect your groups and photo tags, then review a setup that matches your goal.</p><div class="conversation-tags"><span>bird</span><span>wildlife</span></div></div>
      <div class="conversation-review"><strong>Review before sharing</strong><p>Check group rules and membership, edit matching tags, and confirm a sync to <b>all matching configured groups</b>.</p><p class="conversation-outcome">Request queued ≠ accepted by every Flickr group. Follow destination results separately.</p></div>
      <p id="conversation-disclosure" class="conversation-disclosure"><strong>Illustrative example, not a live bot or user screenshot.</strong> This page makes no account changes. The operating flow is implemented locally; public availability awaits deployment and verification.</p>
    </figure>
  </section>
  <section id="conversational-preview" class="conversation-flow" aria-labelledby="conversation-title">
    <p class="conversation-eyebrow">From an idea to a sharing workflow</p>
    <h2 id="conversation-title">Connect. Describe. Review. Share.</h2>
    <ol aria-label="Sharing flow">{steps.map(([title, copy], i) => <li><span class="conversation-number" aria-hidden="true">0{i + 1}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol>
  </section>
  <section class="conversation-start" aria-labelledby="conversation-start-title">
    <h2 id="conversation-start-title">Start with the photos you love.</h2>
    <p>Choose a starting point. After sign-up, you can edit the suggested goal before sending it. Selecting a prompt never executes an action.</p>
    <ul aria-label="Curated starter prompts">{conversationalStarters.map(starter => <li><a href={conversationalSignup("starter", starter.id)} data-conversation-cta data-placement="starter" data-starter={starter.id}><strong>{starter.label} <span aria-hidden="true">↗</span></strong><span>{starter.goal}</span></a></li>)}</ul>
    <div class="conversation-reassurance"><p><strong>Review membership.</strong> An invitation or pending approval is not a ready sharing destination. Flickr rules, permissions and limits still apply.</p><p><strong>Separate fair use.</strong> AI messages have their own allowance, separate from sharing credits. Sharing keeps the existing credit/subscription policy. <a href="/pricing">See pricing</a>.</p></div>
    <a class="conversation-primary try-it-for-free" href={conversationalSignup("final")} data-conversation-cta data-placement="final">Set up with Skedr</a>
  </section>
</div>
<script>
  // Independent of the uncommitted homepage refresh and its analytics helper.
  document.addEventListener("click", event => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[data-conversation-cta]") : null;
    if (!link) return;
    try {
      (window as Window & { posthog?: { capture: (name: string, props: Record<string, string>) => void } }).posthog?.capture("homepage_cta_clicked", { page: "/", placement: link.dataset.placement || "hero", audience: "flickr_photographers", destination: link.href, assistant: "conversational_skedr", starter: link.dataset.starter || "none" });
    } catch { /* Optional analytics cannot prevent ordinary link navigation. */ }
  });
</script>
<style>
  :global(body:has([data-conversational-home]) header.absolute){position:relative;inset:auto;background:#111827}
  :global(body:has([data-conversational-home]) header button){margin:0}
  :global(body:has([data-conversational-home]) > footer nav){margin-inline:0}
  :global(.conversational-proof){overflow:clip;max-width:100%}
  .conversation-home{background:#f8fafc;color:#172033;font-family:inherit;overflow-wrap:anywhere}
  .conversation-hero,.conversation-flow,.conversation-start{max-width:1180px;margin:auto;padding:5rem 1.5rem}
  .conversation-hero{display:grid;grid-template-columns:1.05fr 1fr;gap:3.5rem;align-items:center}
  .conversation-eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:.76rem;font-weight:750;color:#4338ca;margin-bottom:1rem}
  h1{font-size:clamp(2.4rem,4.8vw,4.25rem);line-height:1.08;font-weight:800;letter-spacing:-.045em;margin:0 0 1.6rem}
  h2{font-size:clamp(1.8rem,3vw,2.6rem);line-height:1.2;font-weight:750;letter-spacing:-.025em;margin-bottom:1rem}
  h3{font-size:1.1rem;font-weight:750;margin:.7rem 0}
  p{line-height:1.65}.conversation-lead{font-size:1.14rem;color:#43516b;max-width:40rem}
  .conversation-actions{display:flex;flex-wrap:wrap;gap:1.2rem;align-items:center;margin:1.8rem 0}
  .conversation-primary{display:inline-flex;justify-content:center;border-radius:.55rem;background:#4338ca;color:white;font-weight:700;padding:.9rem 1.3rem;text-decoration:none;min-height:48px}
  .conversation-primary:hover{background:#3730a3}.conversation-secondary{font-weight:650;color:#3730a3;padding:.6rem 0}
  .conversation-note,.conversation-disclosure{font-size:.82rem;color:#536078}
  a:focus-visible{outline:3px solid #4338ca;outline-offset:5px}
  .conversation-example{background:white;border:1px solid #dce1ed;border-radius:1rem;padding:1.5rem;box-shadow:0 20px 60px #14213d0c;margin:0;min-width:0}
  figcaption{font-size:.75rem;text-transform:uppercase;letter-spacing:.07em;color:#536078;margin-bottom:1.5rem}
  .conversation-person{margin-left:1.3rem;background:#eef2ff;border-radius:.7rem;padding:1rem}
  .conversation-person strong,.conversation-response>strong{font-size:.72rem;display:block;text-transform:uppercase;letter-spacing:.05em;color:#4338ca;margin-bottom:.5rem}
  .conversation-person span{display:block}.conversation-response{padding:1.3rem 0}
  .conversation-tags{display:flex;gap:.5rem;margin-top:.8rem}.conversation-tags span{background:#eef2ff;padding:.2rem .7rem;border-radius:1rem;color:#3730a3;font-size:.8rem}
  .conversation-review{border:1px solid #c7d2fe;background:#fafaff;border-radius:.7rem;padding:1rem}.conversation-outcome{font-size:.82rem;color:#43516b;margin-top:.8rem}
  .conversation-disclosure{border-top:1px solid #e5e7eb;margin-top:1.2rem;padding-top:1rem}
  .conversation-flow{border-top:1px solid #dce1ed}.conversation-flow ol{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;padding:0;list-style:none;margin:2.5rem 0 0}
  .conversation-flow li{border-top:3px solid #c7d2fe;padding-top:1rem}.conversation-flow li p{font-size:.92rem;color:#43516b}.conversation-number{color:#4338ca;font-weight:750;font-size:.8rem}
  .conversation-start{padding-top:1.5rem}.conversation-start>p{max-width:48rem;color:#43516b}
  .conversation-start ul{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:0;margin:2rem 0;list-style:none}
  .conversation-start li a{display:block;background:white;border:1px solid #dce1ed;border-radius:.7rem;padding:1.3rem;min-height:140px;text-decoration:none;color:#172033}
  .conversation-start li a:hover{border-color:#4338ca}.conversation-start li strong{display:block;color:#3730a3;margin-bottom:.8rem}.conversation-start li span{display:block;font-size:.9rem;color:#43516b}
  .conversation-reassurance{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin:2rem 0;color:#43516b;font-size:.9rem}.conversation-reassurance a{text-decoration:underline;color:#3730a3}
  @media(max-width:800px){.conversation-hero{grid-template-columns:1fr;gap:2rem}.conversation-hero,.conversation-flow,.conversation-start{padding:3rem 1.25rem}.conversation-flow ol{grid-template-columns:1fr 1fr}.conversation-start ul{grid-template-columns:1fr}.conversation-start li a{min-height:0}.conversation-reassurance{grid-template-columns:1fr;gap:1rem}}
  @media(max-width:400px){.conversation-flow ol{grid-template-columns:1fr}.conversation-example{padding:1rem}.conversation-hero{padding-top:2.5rem}}
</style>
