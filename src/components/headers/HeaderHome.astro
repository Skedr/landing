---
import HomeSignup from "../home/HomeSignup.astro";
import { Image } from "astro:assets";
import Landscape from "../../assets/posts/2024-07-25/Views_from_Lion_Rock_at_Sigiriya-Enric_Bisbe_Gil.jpg";
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-container home-hero-grid">
    <div>
      <p class="home-eyebrow">For your photos. For your Flickr groups.</p>
      <h1 id="home-title">Spend less time sharing to Flickr groups.</h1>
      <p class="home-lead">
        Give your groups tags, then sync a matching photo. Skedr sends it to the
        groups you’ve configured, so you can get back to making pictures.
      </p>
      <div class="home-actions">
        <HomeSignup placement="hero" />
        <a class="home-text-link" href="#how-it-works"
          >See how it works <span aria-hidden="true">↓</span></a
        >
      </div>
      <p class="home-note">
        Start with one group and one photo. Build from there.
      </p>
    </div>
    <figure class="home-example">
      <figcaption class="home-example-label">
        A simple tag-to-group example
      </figcaption>
      <div class="home-example-photo">
        <Image
          src={Landscape}
          alt="Mountains and forest viewed from Lion Rock in Sigiriya, Sri Lanka"
          widths={[320, 540, 1080]}
          sizes="(max-width: 639px) 85vw, 540px"
          loading="eager"
          fetchpriority="high"
        />
        <div>
          <strong>Your Flickr photo</strong><span class="home-tag"
            >landscape</span
          ><span class="home-tag">mountain</span>
        </div>
      </div>
      <div class="home-example-connector">
        <span aria-hidden="true">↓</span> You choose Sync
      </div>
      <div class="home-example-group">
        <span class="home-group-icon" aria-hidden="true">#</span>
        <div>
          <strong>A group you’ve configured</strong><p>
            Group tag: <span class="home-tag">mountain</span>
          </p>
        </div>
      </div>
      <p class="home-example-footnote">
        Matching tag → sharing request.<br />You choose the groups. Their rules
        still apply.
      </p>
      <p class="home-photo-credit">Example photo: Enric Bisbe Gil · Sigiriya</p>
    </figure>
  </div>
</section>
